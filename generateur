def generate_gitignore(selected_sections, header=True, comments=True):
"""Génère le contenu du .gitignore."""
lines = []

if header:
lines.extend([
"# ═══════════════════════════════════════════════════════════════════════════",
"# NEXUS ULTIMATE .gitignore",
"# Généré par NEXUS Gitignore Forge v" + VERSION,
"# Auteur : " + AUTEUR,
"# Licence : " + LICENCE,
"# Date : " + datetime.now().isoformat(),
"# ═══════════════════════════════════════════════════════════════════════════",
"",
])

for key in selected_sections:
sec = SECTIONS.get(key)
if not sec:
continue

if comments:
lines.append("")
lines.append("# ═══════════════════════════════════════════════════════════════════════════")
lines.append(f"# {sec['icon']} {sec['name'].upper()}")
lines.append("# ═══════════════════════════════════════════════════════════════════════════")
lines.append("")

lines.extend(sec["lines"])

lines.append("")
return "\n".join(lines)


def detect_project_type(path):
"""Détecte le type de projet dans un dossier."""
detected = []
p = Path(path)

markers = {
"requirements.txt": "python",
"pyproject.toml": "python",
"setup.py": "python",
"Pipfile": "python",
"Pipfile.lock": "python",
"poetry.lock": "python",
"pdm.lock": "python",
".python-version": "python",
"manage.py": "django",
"settings.py": "django",
"wsgi.py": "django",
"app.py": "flask",
"flask_config.py": "flask",
"fastapi": "fastapi",
"main.py": "python",
"scrapy.cfg": "scrapy",
"celery.py": "celery",
"tasks.py": "celery",
"package.json": "node",
"node_modules": "node",
"Cargo.toml": "rust",
"go.mod": "go",
"Dockerfile": "docker",
"docker-compose.yml": "docker",
"docker-compose.yaml": "docker",
".ipynb": "data-science",
"notebooks": "data-science",
}

if not p.exists() or not p.is_dir():
return ["python"]

try:
files = set(f.name for f in p.iterdir())
except OSError:
return ["python"]

# Extensions notables
extensions = set()
try:
for f in p.iterdir():
if f.is_file() and "." in f.name:
extensions.add(f.suffix.lower())
except OSError:
pass

for marker, proj_type in markers.items():
if marker in files:
detected.append(proj_type)

if ".ipynb" in extensions:
detected.append("data-science")
if ".cob" in extensions or ".cbl" in extensions:
detected.append("cobol")
if ".rs" in extensions:
detected.append("rust")
if ".go" in extensions:
detected.append("go")

# Toujours Python par défaut
if not detected:
detected.append("python")

# Dédupliquer
return list(dict.fromkeys(detected))


