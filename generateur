<body>
<div class="wrap">

<h1>NEXUS Gitignore Forge</h1>
<div class="sub">Ultimate .gitignore generator · localhost · v__V__</div>

<div class="panel">
<h2>⚡ Presets</h2>
<div class="presets" id="presets"></div>
</div>

<div class="panel">
<h2>📁 Détection automatique</h2>
<div class="row">
<input type="text" id="scan-path" placeholder="/chemin/vers/ton/projet (ex: ~/Documents/mon-projet)">
<button class="secondary" onclick="scanProject()">🔍 Scanner</button>
</div>
<div id="scan-result" style="font-family:var(--mono);font-size:11px;color:var(--dim);margin-top:8px"></div>
</div>

<div class="panel">
<h2>📦 Sections <span class="badge" id="count-badge">0 / 0</span></h2>
<div class="grid" id="sections-grid"></div>
</div>

<div class="panel">
<h2>⚙️ Options</h2>
<div class="row">
<label class="checkbox">
<input type="checkbox" id="opt-header" checked>
En-tête NEXUS
</label>
<label class="checkbox">
<input type="checkbox" id="opt-comments" checked>
Commentaires de sections
</label>
</div>
</div>

<div class="panel">
<h2>📄 .gitignore généré</h2>
<div class="stats">
<div class="stat">Lignes : <b id="stat-lines">0</b></div>
<div class="stat">Caractères : <b id="stat-chars">0</b></div>
<div class="stat">Taille : <b id="stat-size">0 B</b></div>
<div class="stat">Sections : <b id="stat-sections">0</b></div>
</div>
<textarea id="output" spellcheck="false"></textarea>
<div class="actions">
<button onclick="copyOutput()">📋 Copier</button>
<button onclick="downloadOutput()">⬇ Télécharger .gitignore</button>
<button class="secondary" onclick="regenerate()">↻ Régénérer</button>
<button class="secondary" onclick="selectPreset('full')">Tout sélectionner</button>
<button class="secondary" onclick="clearAll()">Tout désélectionner</button>
</div>
</div>

<div class="footer">
NEXUS Gitignore Forge v__V__ · Aissa Mohammedi (DGK) · NEXUS-OPEN-2.0
</div>

</div>

<div class="toast" id="toast">Copié !</div>

<script>
const SECTIONS = __SECTIONS_JSON__;
const PRESETS = __PRESETS_JSON__;

let selected = new Set();
let currentPreset = 'python';

// ═══════════════════════════════════════════════════════════════════════════
// RENDER PRESETS
// ═══════════════════════════════════════════════════════════════════════════

function renderPresets() {
const el = document.getElementById('presets');
el.innerHTML = '';
Object.keys(PRESETS).forEach(key => {
const btn = document.createElement('button');
btn.className = 'preset' + (key === currentPreset ? ' active' : '');
btn.textContent = key;
btn.onclick = () => selectPreset(key);
el.appendChild(btn);
});
}

// ═══════════════════════════════════════════════════════════════════════════
// RENDER SECTIONS
// ═══════════════════════════════════════════════════════════════════════════

function renderSections() {
const el = document.getElementById('sections-grid');
el.innerHTML = '';
Object.keys(SECTIONS).forEach(key => {
const sec = SECTIONS[key];
const card = document.createElement('label');
card.className = 'section-card' + (selected.has(key) ? ' checked' : '');
card.innerHTML = `
<input type="checkbox" data-key="${key}" ${selected.has(key) ? 'checked' : ''}>
<span class="icon">${sec.icon}</span>
<div style="flex:1">
<div class="name">${sec.name}</div>
<div class="key">${key}</div>
</div>
`;
const cb = card.querySelector('input');
cb.onchange = () => {
if (cb.checked) selected.add(key);
else selected.delete(key);
renderSections();
regenerate();
};
el.appendChild(card);
});
document.getElementById('count-badge').textContent = `${selected.size} / ${Object.keys(SECTIONS).length}`;
}

// ═══════════════════════════════════════════════════════════════════════════
// SELECTION
// ═══════════════════════════════════════════════════════════════════════════

function selectPreset(key) {
if (!PRESETS[key]) return;
currentPreset = key;
selected = new Set(PRESETS[key]);
renderPresets();
renderSections();
regenerate();
}

function clearAll() {
selected = new Set();
currentPreset = '';
renderPresets();
renderSections();
regenerate();
}

// ═══════════════════════════════════════════════════════════════════════════
// GÉNÉRATION
// ═══════════════════════════════════════════════════════════════════════════

async function regenerate() {
const header = document.getElementById('opt-header').checked;
const comments = document.getElementById('opt-comments').checked;

const resp = await fetch('/api/generate', {
method: 'POST',
headers: {'Content-Type': 'application/json'},
body: JSON.stringify({
sections: Array.from(selected),
header: header,
comments: comments
})
});
const data = await resp.json();
const output = document.getElementById('output');
output.value = data.content || '';

// Stats
const lines = output.value.split('\n').length;
const chars = output.value.length;
const bytes = new Blob([output.value]).size;
document.getElementById('stat-lines').textContent = lines;
document.getElementById('stat-chars').textContent = chars.toLocaleString('fr-FR');
document.getElementById('stat-size').textContent = formatBytes(bytes);
document.getElementById('stat-sections').textContent = selected.size;
}

function formatBytes(b) {
if (b < 1024) return b + ' B';
if (b < 1024 * 1024) return (b / 1024).toFixed(1) + ' KB';
return (b / 1024 / 1024).toFixed(2) + ' MB';
}

// ═══════════════════════════════════════════════════════════════════════════
// SCAN PROJET
// ═══════════════════════════════════════════════════════════════════════════

async function scanProject() {
const path = document.getElementById('scan-path').value.trim();
if (!path) return;

const el = document.getElementById('scan-result');
el.textContent = '⏳ Scan...';

const resp = await fetch('/api/detect', {
method: 'POST',
headers: {'Content-Type': 'application/json'},
body: JSON.stringify({ path: path })
});
const data = await resp.json();

if (!data.ok) {
el.innerHTML = `<span style="color:#ff4466">✗ ${data.error}</span>`;
return;
}

el.innerHTML = `✓ Détecté : <b style="color:#00ff88">${data.types.join(', ')}</b> — ${data.files_count} fichiers analysés`;

// Auto-sélectionner le preset correspondant
const preset = data.preset || 'python';
if (PRESETS[preset]) {
selectPreset(preset);
}
}

// ═══════════════════════════════════════════════════════════════════════════
// ACTIONS
// ═══════════════════════════════════════════════════════════════════════════

function copyOutput() {
const output = document.getElementById('output');
output.select();
document.execCommand('copy');
showToast('✓ Copié dans le presse-papiers');
}

function downloadOutput() {
const content = document.getElementById('output').value;
const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
const url = URL.createObjectURL(blob);
const a = document.createElement('a');
a.href = url;
a.download = '.gitignore';
document.body.appendChild(a);
a.click();
document.body.removeChild(a);
URL.revokeObjectURL(url);
showToast('✓ .gitignore téléchargé');
}

function showToast(msg) {
const t = document.getElementById('toast');
t.textContent = msg;
t.classList.add('show');
setTimeout(() => t.classList.remove('show'), 2000);
}

// ═══════════════════════════════════════════════════════════════════════════
// OPTIONS CHANGENT → RÉGÉNÉRER
// ═══════════════════════════════════════════════════════════════════════════

document.getElementById('opt-header').onchange = regenerate;
document.getElementById('opt-comments').onchange = regenerate;

// ═══════════════════════════════════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════════════════════════════════

renderPresets();
selectPreset('python');
</script>
</body>
</html>
"""


# ═══════════════════════════════════════════════════════════════════════════
# HTTP HANDLER
# ═══════════════════════════════════════════════════════════════════════════

class Handler(BaseHTTPRequestHandler):
server_version = "NexusGitignoreForge/" + VERSION
protocol_version = "HTTP/1.1"

def log_message(self, *a):
pass

def _send(self, code, body, ctype="application/json; charset=utf-8"):
if isinstance(body, str):
body = body.encode("utf-8")
try:
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, code, obj):
self._send(code, json.dumps(obj, indent=2, ensure_ascii=False))

def _html(self, code, text):
self._send(code, text, "text/html; charset=utf-8")

def _body_json(self):
try:
length = int(self.headers.get("Content-Length", "0") or "0")
except Exception:
length = 0
if length <= 0 or length > 5_000_000:
return {}
try:
return json.loads(self.rfile.read(length).decode("utf-8", "ignore") or "{}")
except Exception:
return {}

def do_GET(self):
path = urllib.parse.urlparse(self.path).path
try:
if path in ("/", "/index.html"):
html = HTML_PAGE.replace("__V__", VERSION)
html = html.replace("__SECTIONS_JSON__", json.dumps(SECTIONS, ensure_ascii=False))
html = html.replace("__PRESETS_JSON__", json.dumps(PRESETS, ensure_ascii=False))
return self._html(200, html)

if path == "/api/status":
return self._json(200, {
"ok": True,
"version": VERSION,
"auteur": AUTEUR,
"licence": LICENCE,
"sections": len(SECTIONS),
"presets": len(PRESETS),
})

if path == "/api/sections":
return self._json(200, {"ok": True, "sections": SECTIONS, "presets": PRESETS})

return self._json(404, {"ok": False, "error": "not found"})
except Exception as e:
return self._json(500, {"ok": False, "error": str(e)})

def do_POST(self):
path = urllib.parse.urlparse(self.path).path
try:
data = self._body_json()

if path == "/api/generate":
sections = data.get("sections", [])
header = data.get("header", True)
comments = data.get("comments", True)
content = generate_gitignore(sections, header, comments)
return self._json(200, {
"ok": True,
"content": content,
"lines": content.count("\n") + 1,
"chars": len(content),
})

if path == "/api/detect":
scan_path = data.get("path", "").strip()
scan_path = os.path.expanduser(scan_path)
if not os.path.isdir(scan_path):
return self._json(200, {"ok": False, "error": "Dossier introuvable"})

types = detect_project_type(scan_path)
# Choisir le preset basé sur le type détecté
preset = "python"
if "django" in types: preset = "django"
elif "flask" in types: preset = "flask"
elif "fastapi" in types: preset = "fastapi"
elif "scrapy" in types: preset = "scrapy"
elif "celery" in types: preset = "celery"
elif "data-science" in types: preset = "data-science"
elif "cobol" in types: preset = "cobol"
elif "node" in types: preset = "node"
elif "rust" in types: preset = "rust"
elif "go" in types: preset = "go"

try:
files_count = sum(1 for _ in Path(scan_path).iterdir())
except OSError:
files_count = 0

return self._json(200, {
"ok": True,
"types": types,
"preset": preset,
"files_count": files_count,
})

return self._json(404, {"ok": False, "error": "not found"})
except Exception as e:
return self._json(500, {"ok": False, "error": str(e)})

def do_OPTIONS(self):
try:
self.send_response(204)
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
self.send_header("Access-Control-Allow-Headers", "*")
self.send_header("Content-Length", "0")
self.end_headers()
except Exception:
pass


class Server(ThreadingMixIn, HTTPServer):
daemon_threads = True
allow_reuse_address = True


# ═══════════════════════════════════════════════════════════════════════════
# UTILITAIRES
# ═══════════════════════════════════════════════════════════════════════════

def port_libre(host, port):
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
s.settimeout(1)
s.bind((host, port))
return True
except OSError:
return False
finally:
try:
s.close()
except Exception:
pass


def trouver_port(host, start, max_tries=20):
for p in range(start, start + max_tries):
if port_libre(host, p):
return p
return None


# ═══════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════

def main():
ap = argparse.ArgumentParser(description="NEXUS Gitignore Forge")
ap.add_argument("--port", type=int, default=PORT)
ap.add_argument("--host", default=HOST)
args = ap.parse_args()

print("")
print("=" * 74)
print(f" NEXUS GITIGNORE FORGE v{VERSION} — {CODENAME}")
print("=" * 74)
print(f" Auteur : {AUTEUR}")
print(f" Licence : {LICENCE}")
print("=" * 74)
print("")
print(f" Sections disponibles : {len(SECTIONS)}")
print(f" Presets disponibles : {len(PRESETS)}")
print("")

port = args.port
if not port_libre(args.host, port):
print(f" Port {port} occupé, recherche...")
new_port = trouver_port(args.host, port + 1)
if new_port is None:
print(" Aucun port libre.")
return
port = new_port

print(f" Interface : http://{args.host}:{port}/")
print(f" Local : http://localhost:{port}/")
print("")
print(" Ctrl+C pour arrêter")
print("")

try:
with Server((args.host, port), Handler) as httpd:
httpd.serve_forever()
except KeyboardInterrupt:
print("\n Arrêt.")
except OSError as e:
print(f" Erreur bind : {e}")


if __name__ == "__main__":
main()
